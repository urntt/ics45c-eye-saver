{
  "manifest_version": 3,
  "name": "ICS 45C Eye Saver",
  "version": "0.3.0",
  "description": "A Chromium browser extension that turns the Google Docs embedded in the ICS 45C course site into a clean, natively scrolling reader view.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://docs.google.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://sites.google.com/view/45c-programming-in-cpp/*"],
      "js": ["vendor/highlight.js", "src/converter.js", "src/exporter.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/reader.css"],
      "matches": ["https://sites.google.com/*"]
    }
  ]
}
